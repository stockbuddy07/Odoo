# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gearguard_erp

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
